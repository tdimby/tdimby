{
  "expo": {
    "name": "RunTogether",
    "slug": "runtogether",
    "owner": "tdimby",
    "scheme": "runtogether",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.runtogether.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RunTogether uses your location to track your runs and show your route.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RunTogether tracks your location in the background so your run keeps recording and your friends can see your live progress.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.runtogether.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RunTogether tracks your location during runs and while in the background so your route and pace keep recording."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#111111",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c64ce56e-8550-4b7a-8b86-2826a09518cb"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c64ce56e-8550-4b7a-8b86-2826a09518cb"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
