rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Stage 1: any signed-in account can read/write. This gets tightened
    // to real per-group/private rules in stage 2 (privacy model).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
